  "triggers": {
    "approval_decision_immutable": "CREATE TRIGGER approval_decision_immutable BEFORE UPDATE ON business_approval_steps WHEN OLD.status IN ('approved','rejected') BEGIN SELECT RAISE(ABORT,'approval decisions are immutable'); END",
    "approval_decision_no_delete": "CREATE TRIGGER approval_decision_no_delete BEFORE DELETE ON business_approval_steps BEGIN SELECT RAISE(ABORT,'approval history is immutable'); END",
    "approval_round_no_delete": "CREATE TRIGGER approval_round_no_delete BEFORE DELETE ON business_approval_instances BEGIN SELECT RAISE(ABORT,'approval history is immutable'); END",
    "approval_route_immutable": "CREATE TRIGGER approval_route_immutable BEFORE UPDATE OF business_type,business_id,version,round,route_json,created_at ON business_approval_instances BEGIN SELECT RAISE(ABORT,'approval route snapshot is immutable'); END",
    "business_event_immutable_delete": "CREATE TRIGGER business_event_immutable_delete BEFORE DELETE ON business_events BEGIN SELECT RAISE(ABORT,'business history is append only'); END",
    "business_event_immutable_update": "CREATE TRIGGER business_event_immutable_update BEFORE UPDATE ON business_events BEGIN SELECT RAISE(ABORT,'business history is append only'); END",
    "purchase_version_immutable_delete": "CREATE TRIGGER purchase_version_immutable_delete BEFORE DELETE ON purchase_versions BEGIN SELECT RAISE(ABORT,'submitted versions are immutable'); END",
    "purchase_version_immutable_update": "CREATE TRIGGER purchase_version_immutable_update BEFORE UPDATE ON purchase_versions BEGIN SELECT RAISE(ABORT,'submitted versions are immutable'); END",
    "replenishment_version_no_delete": "CREATE TRIGGER replenishment_version_no_delete BEFORE DELETE ON replenishment_versions BEGIN SELECT RAISE(ABORT,'proposal history is immutable'); END",
    "replenishment_version_no_update": "CREATE TRIGGER replenishment_version_no_update BEFORE UPDATE ON replenishment_versions BEGIN SELECT RAISE(ABORT,'proposal history is immutable'); END"
